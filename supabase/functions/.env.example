# Secretos de las Edge Functions de billing.
#
# Local:      copia este archivo a supabase/functions/.env (ignorado por git) y
#             arranca con:  supabase functions serve --env-file supabase/functions/.env
# Producción: supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... SITE_URL=...
#
# NUNCA subas valores reales al repositorio ni los pegues en un chat.
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.

# Clave del servidor para llamar a la API de Stripe. Recomendado: una clave
# RESTRINGIDA (rk_test_...) con permisos de escritura solo en Customers,
# Checkout Sessions y Customer portal. (sk_test_... también funciona.)
STRIPE_SECRET_KEY=rk_test_xxx

# Secreto de firma del endpoint de webhook (whsec_...). En local lo imprime
# `stripe listen`; en producción, el Dashboard al crear el endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL pública de la app: destino de las redirecciones de Stripe y origen CORS.
SITE_URL=http://127.0.0.1:3000
